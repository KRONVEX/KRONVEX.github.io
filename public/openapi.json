{
  "openapi": "3.1.0",
  "info": {
    "title": "KRONVEX Official Public REST API",
    "version": "1.0.0",
    "summary": "Zero-auth, Tier-1 read-only REST API, OpenAPI 3.1 contract & Streamable HTTP MCP gateway for kronvex.org.",
    "description": "Unified edge API inspired by api-anything and NexusMCP. Serves deterministic JSON envelopes ({ ok, class, tier: 1, version, ms, data }) with field projection, batch execution, local AI hardware-fit recommendations, and BibTeX exports at $0 recurring server cost.",
    "contact": {
      "name": "KRONVEX Organization",
      "url": "https://kronvex.org/api-docs",
      "email": "kronvex1@gmail.com"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://api.kronvex.org",
      "description": "KRONVEX Production Edge REST API (Cloudflare Workers)"
    },
    {
      "url": "https://mcp.kronvex.org",
      "description": "KRONVEX Unified MCP + REST Edge Endpoint"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health, discovery & batch operations"
    },
    {
      "name": "Catalog",
      "description": "Apps, local AI models, SKILL.md library, services & verified work"
    },
    {
      "name": "Intelligence",
      "description": "Top 21 frontier research papers, BibTeX & GitHub/HF radar"
    },
    {
      "name": "Knowledge",
      "description": "Engineering playbook laws & AI/SEO technical glossary"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "API health, version & endpoint directory",
        "responses": {
          "200": {
            "description": "Operational status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "searchKronvex",
        "summary": "Unified fuzzy search across KRONVEX datasets with optional field projection",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query (e.g. webgpu, deepmind, mcp)"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "apps",
                "models",
                "skills",
                "research",
                "services",
                "work"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated field projection list (e.g. id,title,url)"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked search matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Missing query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/apps": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listApps",
        "summary": "List signed cross-platform Windows & Android apps",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apps catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/apps/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getAppById",
        "summary": "Get a single KRONVEX application with artifacts & requirements",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "App not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listModels",
        "summary": "List verified local-first WebGPU/ONNX & GGUF AI models",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Models catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models/recommend": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "recommendModels",
        "summary": "Recommend local AI models that fit a given host RAM budget (GB)",
        "parameters": [
          {
            "name": "ramGb",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 2,
              "maximum": 512,
              "default": 16
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hardware-fitted model recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getModelById",
        "summary": "Get a single AI model specification by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Model not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/skills": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listSkills",
        "summary": "List curated SKILL.md workflows for AI coding agents",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skills catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/skills/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "getSkillById",
        "summary": "Get a single SKILL.md entry by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skill record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Skill not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "listResearch",
        "summary": "List or filter the Top 21 frontier AI & computing arXiv papers",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional keyword/lab filter"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 21,
              "default": 21
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Research papers list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research/{id}": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getResearchPaper",
        "summary": "Get a frontier paper by rank (1-21) or arXiv ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research/{id}/bibtex": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getPaperBibtex",
        "summary": "Export verified BibTeX citation for a paper by rank or arXiv ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "BibTeX payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/top21": {
      "get": {
        "tags": [
          "Intelligence"
        ],
        "operationId": "getTop21",
        "summary": "Get live 6-hour synced Top 21 GitHub & Hugging Face leaderboards",
        "parameters": [
          {
            "name": "board",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "github",
                "hf",
                "weekly",
                "all"
              ],
              "default": "github"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 21,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Leaderboard snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listServices",
        "summary": "List KRONVEX custom software & AI-native engineering services",
        "responses": {
          "200": {
            "description": "Services catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listCaseStudies",
        "summary": "List verified production engineering case studies with live telemetry",
        "responses": {
          "200": {
            "description": "Case studies list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/playbook": {
      "get": {
        "tags": [
          "Knowledge"
        ],
        "operationId": "getPlaybook",
        "summary": "Query KRONVEX 6 engineering laws & 16-term AI/MCP/GEO technical glossary",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Playbook & glossary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/batch": {
      "post": {
        "tags": [
          "System"
        ],
        "operationId": "executeBatch",
        "summary": "Execute up to 10 read-only REST operations in 1 HTTP round-trip (api-anything pattern)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "calls"
                ],
                "properties": {
                  "calls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string",
                          "example": "/v1/search?q=webgpu&limit=3"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch execution results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid batch request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "class",
          "tier",
          "version",
          "ms",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "class": {
            "type": "string",
            "enum": [
              "ok",
              "input",
              "not_found",
              "method",
              "rate",
              "error"
            ]
          },
          "tier": {
            "type": "integer",
            "example": 1
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "ms": {
            "type": "integer",
            "example": 14
          },
          "data": {},
          "nextRequest": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "ok",
          "class",
          "reason"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "class": {
            "type": "string",
            "example": "input"
          },
          "reason": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        }
      }
    }
  }
}